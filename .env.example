# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quickpayments

# Stitch
STITCH_CLIENT_ID=your_stitch_client_id
STITCH_CLIENT_SECRET=your_stitch_client_secret
STITCH_REDIRECT_URI=https://your-domain.com/api/v1/webhooks/stitch
STITCH_API_URL=https://api.stitch.money/graphql
STITCH_WEBHOOK_SECRET=your_stitch_webhook_secret

# Smile Identity (KYC — identity document verification)
SMILE_IDENTITY_API_KEY=your_smile_identity_api_key
SMILE_IDENTITY_PARTNER_ID=your_smile_identity_partner_id
SMILE_IDENTITY_BASE_URL=https://api.smileidentity.com

# App
DEFAULT_FEE_PERCENTAGE=2.5
ENVIRONMENT=development
MAX_SPLIT_RETRIES=3
MAX_RETRY_QUEUE_SIZE=50
DLQ_ALERT_WEBHOOK_URL=

# Admin — used for internal endpoints (e.g. GET /api/v1/reconciliation)
# Must not be shared with platform API keys
ADMIN_API_KEY=your_admin_api_key

# Encryption key (POPIA Section 19 — personal data at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key
